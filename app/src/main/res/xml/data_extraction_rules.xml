<?xml version="1.0" encoding="utf-8"?>
<!--
  Os dados do app são locais e não devem sair do aparelho por backup automático
  nem por transferência entre dispositivos. O backup é feito pelo próprio app (JSON).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
